{
  "name": "dsh-tavern-card-updater",
  "version": "1.76.0",
  "description": "DSH Tavern 鍗＄墖鏇存柊鍣細鎸夐摼鎺ユ娴嬩汉鐗╁崱鏇存柊銆佹洿鏂板師鐗堝崱锛屽苟鎶婂彉鏇村悎骞惰繘 MVU 鐗堝崱銆侰ard updater for DSH Tavern: diff remote cards by link, refresh the original, and merge into the MVU variant.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./client.js": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "install.ps1",
    "uninstall.ps1",
    "install.sh",
    "uninstall.sh",
    "PERMISSIONS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run.mjs && node test/client.mjs && node test/real.mjs",
    "test:host": "node test/run.mjs",
    "test:client": "node test/client.mjs",
    "test:real": "node test/real.mjs",
    "test:perf": "node test/perf.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XGUIMAX/dsh-tavern-card-updater.git"
  },
  "bugs": {
    "url": "https://github.com/XGUIMAX/dsh-tavern-card-updater/issues"
  },
  "homepage": "https://github.com/XGUIMAX/dsh-tavern-card-updater#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-tavern",
    "tavern",
    "character-card",
    "mvu",
    "card-updater"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8",
      "dshReleases": {
        "0.1.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
